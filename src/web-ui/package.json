{
  "name": "@openbitfun/web-ui",
  "version": "1.0.3",
  "private": true,
  "description": "OpenBitFun Web UI - 支持 Desktop 和 Server 两种部署方式",
  "type": "module",
  "scripts": {
    "icons:generate": "node scripts/generate-lucide-static-icons.mjs",
    "icons:check": "node scripts/generate-lucide-static-icons.mjs --check",
    "prepare:design-system:dev": "pnpm --dir ../../design-system run prepare:consumer-dev",
    "prepare:design-system:build": "pnpm --dir ../../design-system run build:packages",
    "predev": "pnpm run prepare:design-system:dev",
    "predev:force": "pnpm run prepare:design-system:dev",
    "prebuild": "pnpm run prepare:design-system:build",
    "prebuild:desktop": "pnpm run prepare:design-system:build",
    "prebuild:web": "pnpm run prepare:design-system:build",
    "pretest:run": "pnpm run prepare:design-system:build",
    "pretype-check": "pnpm run prepare:design-system:build",
    "dev": "vite",
    "dev:force": "vite --force",
    "gen:types": "node scripts/gen-api-barrel.mjs --clean && cargo test --locked --package openbitfun-app-server-protocol --no-default-features --features ts --lib export -- --nocapture && node scripts/gen-api-barrel.mjs",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "build:web": "vite build --mode web",
    "build:with-types": "npm run gen:types && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=50%"
  },
  "dependencies": {
    "@openbitfun/flow-chat-presentation": "workspace:*",
    "@openbitfun/design-tokens": "workspace:^",
    "@openbitfun/theme-openbitfun": "workspace:^",
    "@openbitfun/ui": "workspace:^",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-virtual": "^3.13.23",
